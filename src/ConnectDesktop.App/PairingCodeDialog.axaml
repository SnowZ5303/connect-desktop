<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:ConnectDesktop.App.Services"
        x:Class="ConnectDesktop.App.PairingCodeDialog"
        Title="{s:Tr dialog.pair_title}"
        Width="460" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
  <Border Classes="card" Margin="16">
    <StackPanel Spacing="16">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Path Classes="icon" Data="{StaticResource IconKey}" />
        <TextBlock Classes="title" Text="{s:Tr dialog.pair_heading}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="muted" TextWrapping="Wrap" Text="{s:Tr dialog.pair_text}" />

      <Border CornerRadius="18" Padding="6" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
              Background="{DynamicResource AccentSoftBrush}">
        <TextBox x:Name="CodeBox"
                 Height="66"
                 FontSize="34"
                 FontWeight="Bold"
                 Background="Transparent"
                 BorderThickness="0"
                 Watermark="000 000"
                 TextAlignment="Center"
                 VerticalContentAlignment="Center"
                 TextChanged="OnCodeChanged" />
      </Border>

      <TextBlock x:Name="ErrorText" IsVisible="False" Foreground="{DynamicResource StatusErrorBrush}"
                 TextWrapping="Wrap" />

      <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
        <Button Classes="tile" Margin="0,0,6,0" Click="OnCancelClick">
          <TextBlock Text="{s:Tr dialog.pair_cancel}" />
        </Button>
        <Button x:Name="ConnectButton" Grid.Column="1" Margin="6,0,0,0" Classes="primary" IsDefault="True" Click="OnConnectClick">
          <TextBlock Text="{s:Tr dialog.pair_connect}" />
        </Button>
      </Grid>
    </StackPanel>
  </Border>
</Window>
