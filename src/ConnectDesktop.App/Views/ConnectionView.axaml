<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:ConnectDesktop.App.Services"
             xmlns:art="using:ConnectDesktop.App.Views.Art"
             x:Class="ConnectDesktop.App.Views.ConnectionView">
  <UserControl.Styles>
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Border.banner.error">
      <Setter Property="Background" Value="{DynamicResource StatusErrorSoftBrush}" />
    </Style>
    <Style Selector="Border.band">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="18,12" />
    </Style>
    <Style Selector="Ellipse.spinner">
      <Setter Property="RenderTransformOrigin" Value="50%,50%" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
      <Style.Animations>
        <Animation Duration="0:0:1.2" IterationCount="INFINITE">
          <KeyFrame Cue="0%">
            <Setter Property="RotateTransform.Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="RotateTransform.Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="14" Margin="8,4,22,18">

      <!-- Avisos no topo: atualização disponível e permissões -->
      <Border x:Name="UpdateBanner" Classes="banner" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="8">
            <TextBlock x:Name="UpdateText" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ProgressBar x:Name="UpdateProgress" IsVisible="False" Minimum="0" Maximum="1" Height="6" />
          </StackPanel>
          <Button x:Name="UpdateButton" Grid.Column="1" Margin="12,0,0,0" Classes="primary" Height="40" Click="OnUpdateClick"
                  VerticalAlignment="Center">
            <TextBlock Text="{s:Tr conn.update_now}" />
          </Button>
        </Grid>
      </Border>

      <Border x:Name="WarningBorder" Classes="banner error" IsVisible="False">
        <TextBlock x:Name="WarningText" TextWrapping="Wrap" />
      </Border>

      <!-- Cabeçalho: logo e texto (coluna *, quebra de linha) e ilustração (coluna fixa de 300) -->
      <Grid ColumnDefinitions="*,300" Margin="0,8,0,4">
        <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
          <Path Grid.Column="0" Data="{StaticResource IconLink}" Stretch="Uniform" Width="72" Height="72"
                StrokeThickness="2.6" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                Margin="0,0,20,0">
            <Path.Stroke>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight1}" />
                <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark1}" />
              </LinearGradientBrush>
            </Path.Stroke>
          </Path>
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="{s:Tr app.title}" FontSize="34" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="muted" FontSize="15" Text="{s:Tr conn.subtitle}" TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
        <Viewbox Grid.Column="1" Width="300" Height="140" Stretch="Uniform" VerticalAlignment="Center">
          <art:HeroArt />
        </Viewbox>
      </Grid>

      <!-- Nome deste PC -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{StaticResource IconMonitor}" />
            <TextBlock Classes="title" Text="{s:Tr conn.name_card}" VerticalAlignment="Center" />
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="NameBox" Classes="field" MaxLength="40" />
            <Button x:Name="SaveNameButton" Grid.Column="1" Margin="14,0,0,0" Classes="primary" MinWidth="160" Click="OnSaveNameClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon" Data="{StaticResource IconSave}" Stroke="White" />
                <TextBlock Text="{s:Tr conn.name_save}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Papel deste PC -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{StaticResource IconWindows}" />
            <TextBlock Classes="title" Text="{s:Tr conn.role_card}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Spacing="10" Margin="36,0,0,0">
            <RadioButton x:Name="PrimaryRadio" GroupName="Papel" Content="{s:Tr conn.role_primary}"
                         Click="OnRoleChecked" />
            <RadioButton x:Name="SecondaryRadio" GroupName="Papel" Content="{s:Tr conn.role_secondary}"
                         Click="OnRoleChecked" />
          </StackPanel>
          <Border x:Name="StatusBand" Classes="band">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <Grid Width="24" Height="24">
                <Ellipse x:Name="Spinner" Classes="spinner" Width="22" Height="22"
                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.2"
                         StrokeDashArray="2.4,2.4" StrokeLineCap="Round" />
                <Ellipse x:Name="StatusDot" Width="10" Height="10" IsVisible="False"
                         Fill="{DynamicResource StatusOkBrush}" />
              </Grid>
              <TextBlock x:Name="StatusText" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Código de pareamento (PC secundário) -->
      <Border x:Name="PairCard" Classes="card" IsVisible="False">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{StaticResource IconKey}" />
            <TextBlock Classes="title" Text="{s:Tr conn.pair_card}" VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
            <Border Padding="14">
              <Border Width="420" Height="84" CornerRadius="16" BorderBrush="{DynamicResource AccentBrush}"
                      BorderThickness="2" Background="{DynamicResource CardBrush}">
                <Border.Effect>
                  <DropShadowEffect Color="{DynamicResource SystemAccentColor}" BlurRadius="24" Opacity="0.6" />
                </Border.Effect>
                <TextBlock x:Name="CodeText" Text="--- ---" FontSize="52" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
              </Border>
            </Border>
            <Button x:Name="CopyButton" Classes="tile" Width="136" Height="50" VerticalAlignment="Center"
                    Click="OnCopyClick">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Classes="icon" Data="{StaticResource IconCopy}" />
                <TextBlock Text="{s:Tr conn.copy}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
          <TextBlock Classes="muted" HorizontalAlignment="Center" Text="{s:Tr conn.pair_hint}" />
          <TextBlock x:Name="LocalIpText" Classes="muted" HorizontalAlignment="Center" IsVisible="False" />
        </StackPanel>
      </Border>

      <!-- Posição do outro PC (PC principal) -->
      <Border x:Name="PositionCard" Classes="card" IsVisible="False">
        <StackPanel Spacing="14">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{StaticResource IconPosition}" />
            <TextBlock Classes="title" Text="{s:Tr conn.position_card}" VerticalAlignment="Center" />
          </StackPanel>

          <Grid RowDefinitions="*,*,*" ColumnDefinitions="*,*,*" Height="190">
            <Button x:Name="TopSide" Grid.Row="0" Grid.Column="1" Classes="side" Tag="Top"
                    Content="{s:Tr conn.side_top}" Click="OnSideClick" />
            <Button x:Name="LeftSide" Grid.Row="1" Grid.Column="0" Classes="side" Tag="Left"
                    Content="{s:Tr conn.side_left}" Click="OnSideClick" />
            <Border Grid.Row="1" Grid.Column="1" Margin="6" CornerRadius="12"
                    Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <Path Classes="icon" Data="{StaticResource IconMonitor}" HorizontalAlignment="Center" />
                <TextBlock Text="{s:Tr conn.this_pc}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
            <Button x:Name="RightSide" Grid.Row="1" Grid.Column="2" Classes="side" Tag="Right"
                    Content="{s:Tr conn.side_right}" Click="OnSideClick" />
            <Button x:Name="BottomSide" Grid.Row="2" Grid.Column="1" Classes="side" Tag="Bottom"
                    Content="{s:Tr conn.side_bottom}" Click="OnSideClick" />
          </Grid>

          <TextBlock Classes="muted" TextWrapping="Wrap" Text="{s:Tr conn.escape_hint}" />

          <Border Background="{DynamicResource InputBrush}" CornerRadius="12" Padding="16,10">
            <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock x:Name="SummaryText" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button x:Name="DisconnectButton" Grid.Column="1" Classes="tile" Height="40" MinWidth="150"
                      Click="OnDisconnectClick">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="icon" Data="{StaticResource IconDisconnect}" />
                  <TextBlock Text="{s:Tr conn.disconnect}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel x:Name="ChooseRow" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                <Button x:Name="ChooseDeviceLink" Classes="link" Click="OnChooseDeviceClick">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{s:Tr conn.choose_device}" VerticalAlignment="Center" />
                    <Path Classes="icon accent" Data="{StaticResource IconArrowRight}" Width="18" Height="18" />
                  </StackPanel>
                </Button>
                <TextBlock Classes="muted" Text="{s:Tr conn.or}" VerticalAlignment="Center" />
                <Button x:Name="ConnectByIpLink" Classes="link" Click="OnConnectByIpLinkClick"
                        Content="{s:Tr conn.connect_by_ip}" />
              </StackPanel>
            </Grid>
            <StackPanel x:Name="IpPanel" Spacing="8" IsVisible="False">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="IpBox" Classes="field" Watermark="{s:Tr conn.ip_placeholder}" KeyDown="OnIpKeyDown" />
                <Button x:Name="ConnectIpButton" Grid.Column="1" Classes="primary" MinWidth="130" Margin="10,0,0,0"
                        Click="OnConnectByIpClick">
                  <TextBlock Text="{s:Tr conn.connect}" />
                </Button>
              </Grid>
              <ProgressBar x:Name="IpProgress" IsIndeterminate="True" IsVisible="False" Height="4" />
            </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- Opções -->
      <StackPanel Spacing="6" Margin="8,6,0,0">
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,8" />
        <CheckBox x:Name="ClipboardCheck" Content="{s:Tr conn.clipboard}"
                  Checked="OnOptionToggled" Unchecked="OnOptionToggled" />
        <CheckBox x:Name="UpdatesCheck" Content="{s:Tr conn.updates_on_start}"
                  Checked="OnOptionToggled" Unchecked="OnOptionToggled" />
        <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,8,0,4" />
      </StackPanel>

      <Grid ColumnDefinitions="*,*">
        <Button x:Name="CheckUpdatesButton" Classes="primary" Click="OnCheckUpdatesClick">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{StaticResource IconRefresh}" Stroke="White" />
            <TextBlock Text="{s:Tr conn.check_updates}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button x:Name="PairsButton" Grid.Column="1" Margin="14,0,0,0" Classes="tile" Click="OnPairsClick">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Path Classes="icon" Data="{StaticResource IconBookmark}" />
            <TextBlock Text="{s:Tr conn.saved_pairs}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock x:Name="UpdateInfoText" Classes="muted" TextWrapping="Wrap" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
